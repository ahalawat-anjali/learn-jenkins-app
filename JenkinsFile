pipeline {
    agent any

    stages {
        stage('Build') {
            agent{
                docker{
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                echo 'Hello World'
                sh '''
                    ls -la
                    node -v
                    npm -v
                    npm ci #to instal server
                    npm run build
                    ls -las
                '''
            }
        }
    }
}
