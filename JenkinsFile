        stage ('Test'){
            agent{
                docker{
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps{
                sh '''
                echo "Test Stage"
                #test -f build/index.html
                npm test
                '''
            }
        }
        stage ('E2E'){
            agent{
                docker{
                    image 'mcr.microsoft.com/playwright:v1.58.0-noble'
                    reuseNode true
                }
            }
            steps{
                sh '''
                npm install -g serve
                serve -s build
                npx playwrite test
                '''
            }
        }
        
    }
    post{
            always{
                junit 'test-results/junit.xml'
            }
        }
}
